<script type="text/javascript">
var fonSortAscending = false;

function fonToggleSortOrder() {
	fonSortAscending = !fonSortAscending;
	var container = $('#fon-announcements-container');
	var cards = container.children('.fon-announcement-card').get();
	
	cards.sort(function(a, b) {
		var timeA = parseInt($(a).attr('data-time')) || parseInt($(a).attr('data-id')) || 0;
		var timeB = parseInt($(b).attr('data-time')) || parseInt($(b).attr('data-id')) || 0;
		return fonSortAscending ? (timeA - timeB) : (timeB - timeA);
	});
	
	$.each(cards, function(idx, item) {
		container.append(item);
	});
	
	if (fonSortAscending) {
		$('#fon-sort-label').text('Oldest First');
		$('#fon-sort-icon').removeClass('fa-sort-amount-desc').addClass('fa-sort-amount-asc');
	} else {
		$('#fon-sort-label').text('Newest First');
		$('#fon-sort-icon').removeClass('fa-sort-amount-asc').addClass('fa-sort-amount-desc');
	}
}

function fonCopyAnnouncementLink(id) {
	var currentUrl = window.location.href.split('#')[0];
	var shareUrl = currentUrl + '#announcement-' + id;
	
	if (navigator.clipboard && window.isSecureContext) {
		navigator.clipboard.writeText(shareUrl).then(function() {
			fonShowToast();
		});
	} else {
		var tempInput = document.createElement("input");
		tempInput.value = shareUrl;
		document.body.appendChild(tempInput);
		tempInput.select();
		document.execCommand("copy");
		document.body.removeChild(tempInput);
		fonShowToast();
	}
}

function fonShowToast() {
	var toast = $('#fon-ann-toast');
	toast.addClass('show');
	setTimeout(function() {
		toast.removeClass('show');
	}, 2500);
}

var fonCurrentFilter = 'all';

function fonFilterType(type, btn) {
	fonCurrentFilter = type;
	$('.fon-type-filter').removeClass('btn-primary active').addClass('btn-default');
	$(btn).removeClass('btn-default').addClass('btn-primary active');
	fonApplyFilters();
}

function fonApplyFilters() {
	var query = $('#fon-ann-search').val().toLowerCase().trim();
	var visibleCount = 0;
	
	$('.fon-announcement-card').each(function() {
		var cardType = $(this).attr('data-type') || 'announcement';
		var cardText = $(this).text().toLowerCase();
		var typeMatch = (fonCurrentFilter === 'all' || cardType === fonCurrentFilter);
		var textMatch = (query === '' || cardText.indexOf(query) !== -1);
		
		if (typeMatch && textMatch) {
			$(this).show();
			visibleCount++;
		} else {
			$(this).hide();
		}
	});
	
	if (visibleCount === 0 && $('.fon-announcement-card').length > 0) {
		$('#fon-no-search-results').show();
	} else {
		$('#fon-no-search-results').hide();
	}
	
	$('#fon-ann-count').text(visibleCount);
}

$(function() {
	// Search filter
	$('#fon-ann-search').on('keyup', function() {
		fonApplyFilters();
	});

	// Smooth scroll and highlight if hash exists in URL
	function checkHashAnchor() {
		var hash = window.location.hash;
		if (hash && hash.indexOf('#announcement-') === 0) {
			var target = $(hash);
			if (target.length) {
				$('html, body').animate({
					scrollTop: target.offset().top - 90
				}, 400);
				target.addClass('fon-highlight-active');
				setTimeout(function() {
					target.removeClass('fon-highlight-active');
				}, 4000);
			}
		}
	}
	
	setTimeout(checkHashAnchor, 250);
	$(window).on('hashchange', checkHashAnchor);
});
</script>
