<script>
$(document).ready(function() {
    var $modal = $('#fon-feature-discovery-modal');
    if ($modal.length) {
        $modal.modal({
            backdrop: 'static',
            keyboard: true,
            show: true
        });

        // Set focus to the primary button for accessibility
        setTimeout(function() {
            $('#fon-discovery-next-btn').focus();
        }, 300);

        var allIntros = <?php echo json_encode($all_intros); ?>;
        var currentStep = <?php echo $step; ?>;
        var totalSteps = <?php echo $total; ?>;
        var sessionId = '<?php echo addslashes($session_id); ?>';

        function sendAck(stepId) {
            $.ajax({
                url: Wo_Ajax_Requests_File() + '?f=feature_discovery&action=ack',
                type: 'POST',
                dataType: 'json',
                data: {
                    intro_id: stepId,
                    login_id: sessionId
                }
            });
        }

        function renderStep(step) {
            if (!allIntros[step]) return;
            var data = allIntros[step];

            // 1. Text transition
            var $heading = $('#fon-discovery-heading');
            var $desc = $('#fon-discovery-desc');
            $heading.css('opacity', '0');
            $desc.css('opacity', '0');

            setTimeout(function() {
                $heading.text(data.title).css('opacity', '1');
                $desc.text(data.description).css('opacity', '1');
            }, 150);

            // 2. Icon & Header Accent
            $('#fon-discovery-icon').attr('class', 'fa fa-' + data.icon);
            $('#fon-discovery-icon-wrapper').css({
                'color': data.accent_color,
                'transform': 'scale(1.08)'
            });
            setTimeout(function() {
                $('#fon-discovery-icon-wrapper').css('transform', 'scale(1)');
            }, 200);

            $('#fon-discovery-header-accent').css('background', 'linear-gradient(135deg, ' + data.accent_color + ', #a84849)');

            // 3. Step pill and text
            $('#fon-discovery-step-text').text(data.step + ' of ' + data.total);
            $('#fon-discovery-step-pill').css({
                'color': data.accent_color,
                'border-color': data.accent_color + '33'
            });

            // 4. Progress dots
            $('#fon-discovery-step-dots .fon-dot').each(function() {
                var dotStep = parseInt($(this).attr('data-step'), 10);
                if (dotStep === step) {
                    $(this).addClass('active').css('background-color', data.accent_color);
                } else if (dotStep < step) {
                    $(this).removeClass('active').css('background-color', data.accent_color);
                } else {
                    $(this).removeClass('active').css('background-color', '#cbd5e1');
                }
            });

            // 5. Buttons
            var $primaryBtn = $('#fon-discovery-next-btn');
            $primaryBtn.css({
                'background-color': data.accent_color,
                'border-color': data.accent_color
            });

            if (step >= totalSteps) {
                $('#fon-discovery-btn-label').text('Get Started');
                $('#fon-discovery-btn-arrow').hide();
                $('#fon-discovery-skip-btn').hide();
            } else {
                $('#fon-discovery-btn-label').text('Next');
                $('#fon-discovery-btn-arrow').show();
                $('#fon-discovery-skip-btn').show();
            }

            if (step > 1) {
                $('#fon-discovery-back-btn').show();
            } else {
                $('#fon-discovery-back-btn').hide();
            }
        }

        // Primary Button Click: Next step OR Finish
        $('#fon-discovery-next-btn').on('click', function(e) {
            e.preventDefault();
            
            // Record acknowledgment for the current step
            sendAck(currentStep);

            if (currentStep < totalSteps) {
                currentStep++;
                renderStep(currentStep);
            } else {
                // Completed all 5 steps!
                $modal.modal('hide');
            }
        });

        // Back Button Click
        $('#fon-discovery-back-btn').on('click', function(e) {
            e.preventDefault();
            if (currentStep > 1) {
                currentStep--;
                renderStep(currentStep);
            }
        });

        // Click on progress dots to jump directly to any step
        $('#fon-discovery-step-dots .fon-dot').on('click', function() {
            var targetStep = parseInt($(this).attr('data-step'), 10);
            if (targetStep >= 1 && targetStep <= totalSteps && targetStep !== currentStep) {
                sendAck(currentStep);
                currentStep = targetStep;
                renderStep(currentStep);
            }
        });

        // Skip button
        $('#fon-discovery-skip-btn').on('click', function(e) {
            e.preventDefault();
            sendAck(currentStep);
            $modal.modal('hide');
        });
    }
});
</script>
