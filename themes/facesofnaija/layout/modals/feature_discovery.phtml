<?php
if ($wo['loggedin'] == false || empty($wo['user']['user_id'])) {
    return;
}

if (!function_exists('Wo_GetFeatureDiscoveryStatus')) {
    if (file_exists('assets/includes/feature_discovery.php')) {
        require_once('assets/includes/feature_discovery.php');
    } else {
        return;
    }
}

$user_id = (int)$wo['user']['user_id'];
$discovery = Wo_GetFeatureDiscoveryStatus($user_id);
$all_intros = Wo_GetFeatureDiscoveryIntros();

// Check if user explicitly wants to preview/test intro via ?test_welcome=1 or ?welcome_intro=1
$is_test_preview = (!empty($_GET['test_welcome']) || !empty($_GET['welcome_intro']));

// If all 5 introductions have been completed and not in test preview, stop permanently
if (!$is_test_preview && (empty($discovery['should_show']) || empty($discovery['current_intro']))) {
    return;
}

// Current session identifier
$session_id = !empty($_SESSION['user_id']) ? $_SESSION['user_id'] : (!empty($_COOKIE['user_id']) ? $_COOKIE['user_id'] : '');

// Distinct login session rule:
// 1. If already shown in this PHP session, do not show on page refresh or navigation
$session_key = 'fon_discovery_seen_' . ($session_id ? md5($session_id) : $user_id);
if (!$is_test_preview && !empty($_SESSION[$session_key])) {
    return;
}

// 2. If the user reopened the app/browser with an existing session where this intro step was already acknowledged, do not show
if (!$is_test_preview && !empty($session_id) && !empty($discovery['last_login_id']) && $discovery['last_login_id'] === $session_id) {
    return;
}

// Mark this session as having displayed the intro so page refresh or navigation never displays it again
$_SESSION[$session_key] = true;

$intro = !empty($discovery['current_intro']) ? $discovery['current_intro'] : $all_intros[1];

$intro_id = (int)$intro['id'];
$step = (int)$intro['step'];
$total = (int)$intro['total'];
$title = htmlspecialchars($intro['title'], ENT_QUOTES, 'UTF-8');
$description = htmlspecialchars($intro['description'], ENT_QUOTES, 'UTF-8');
$icon = htmlspecialchars($intro['icon'], ENT_QUOTES, 'UTF-8');
$accent = htmlspecialchars($intro['accent_color'], ENT_QUOTES, 'UTF-8');

// Natural greeting using the member's first name
$first_name = '';
if (!empty($wo['user']['first_name'])) {
    $first_name = trim($wo['user']['first_name']);
} elseif (!empty($wo['user']['name'])) {
    $parts = explode(' ', trim($wo['user']['name']));
    $first_name = $parts[0];
} elseif (!empty($wo['user']['username'])) {
    $first_name = trim($wo['user']['username']);
}

$greeting = !empty($first_name) ? ('Good to have you, ' . htmlspecialchars($first_name, ENT_QUOTES, 'UTF-8') . '!') : 'Welcome home to FacesOfNaija!';
?>

<div class="modal fade fon-feature-discovery-modal" id="fon-feature-discovery-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="fon-discovery-heading" aria-describedby="fon-discovery-desc" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content fon-discovery-card">
            <button type="button" class="close fon-discovery-close-btn" data-dismiss="modal" aria-label="Close" title="Close">
                <span aria-hidden="true">&times;</span>
            </button>

            <!-- Branded Accent Header -->
            <div class="fon-discovery-header-accent" id="fon-discovery-header-accent" style="background: linear-gradient(135deg, <?php echo $accent; ?>, #a84849);">
                <div class="fon-discovery-brand-tag" id="fon-discovery-brand-tag"><?php echo $greeting; ?></div>
                <div class="fon-discovery-icon-wrapper" id="fon-discovery-icon-wrapper" style="color: <?php echo $accent; ?>;">
                    <i class="fa fa-<?php echo $icon; ?>" id="fon-discovery-icon" aria-hidden="true"></i>
                </div>
            </div>
            
            <!-- Modal Body Content -->
            <div class="modal-body fon-discovery-body">
                <!-- Progress Indicator (e.g. 1 of 5) and Dots -->
                <div class="fon-discovery-progress-wrap">
                    <span class="fon-discovery-step-pill" id="fon-discovery-step-pill" style="color: <?php echo $accent; ?>; border-color: <?php echo $accent; ?>33;">
                        <span class="fon-discovery-step-dots" id="fon-discovery-step-dots" aria-hidden="true">
                            <?php for ($i = 1; $i <= $total; $i++): ?>
                                <span class="fon-dot <?php echo ($i == $step) ? 'active' : ''; ?>" data-step="<?php echo $i; ?>" style="<?php echo ($i <= $step) ? 'background-color:' . $accent . ';' : ''; ?>"></span>
                            <?php endfor; ?>
                        </span>
                        <span id="fon-discovery-step-text"><?php echo $step; ?> of <?php echo $total; ?></span>
                    </span>
                </div>

                <div class="fon-discovery-text-content">
                    <h3 class="fon-discovery-heading" id="fon-discovery-heading">
                        <?php echo $title; ?>
                    </h3>

                    <p class="fon-discovery-desc" id="fon-discovery-desc">
                        <?php echo $description; ?>
                    </p>
                </div>

                <!-- Footer with Next / OK Button and Navigation -->
                <div class="fon-discovery-footer">
                    <button type="button" class="btn btn-main fon-discovery-primary-btn" id="fon-discovery-next-btn" style="background-color: <?php echo $accent; ?>; border-color: <?php echo $accent; ?>;">
                        <span id="fon-discovery-btn-label"><?php echo ($step < $total) ? 'Next' : 'Get Started'; ?></span>
                        <i class="fa fa-arrow-right fon-discovery-btn-arrow" id="fon-discovery-btn-arrow" style="<?php echo ($step >= $total) ? 'display:none;' : ''; ?>"></i>
                    </button>

                    <div class="fon-discovery-nav-row">
                        <button type="button" class="btn btn-link fon-discovery-back-btn" id="fon-discovery-back-btn" style="<?php echo ($step <= 1) ? 'display:none;' : ''; ?>">
                            <i class="fa fa-arrow-left"></i> Back
                        </button>
                        <button type="button" class="btn btn-link fon-discovery-skip-btn" id="fon-discovery-skip-btn">
                            Skip for now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

