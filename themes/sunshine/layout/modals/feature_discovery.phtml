<script>
$(document).ready(function() {
    var $modal = $('#fon-feature-discovery-modal');
    if ($modal.length) {
        $modal.modal({
            backdrop: 'static',
            keyboard: true,
            show: true
        });

        // Set focus to the OK button for accessibility
        setTimeout(function() {
            $('#fon-discovery-ok-btn').focus();
        }, 300);

        var introId = <?php echo $intro_id; ?>;
        var sessionId = '<?php echo addslashes($session_id); ?>';
        var acknowledged = false;

        function recordAcknowledgment() {
            if (acknowledged) return;
            acknowledged = true;

            $.ajax({
                url: Wo_Ajax_Requests_File() + '?f=feature_discovery&action=ack',
                type: 'POST',
                dataType: 'json',
                data: {
                    intro_id: introId,
                    login_id: sessionId
                }
            });
        }

        // Clicking "OK, Got It" closes modal immediately and saves acknowledgment
        $('#fon-discovery-ok-btn').on('click', function(e) {
            e.preventDefault();
            recordAcknowledgment();
            $modal.modal('hide');
        });

        // Closing via X button or Esc also safely dismisses modal and acknowledges
        $modal.on('hidden.bs.modal', function() {
            recordAcknowledgment();
        });
    }
});
</script>
