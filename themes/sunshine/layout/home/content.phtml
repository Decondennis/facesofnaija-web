function stripHtml(html) {
    var tmp = document.createElement("DIV");
    tmp.innerHTML = html;
    return tmp.textContent || tmp.innerText || "";
}

function fonExtractFriendlyName(fullName, firstName) {
    var raw = (firstName || '').trim();
    if (!raw) raw = (fullName || '').trim();
    raw = raw.replace(/[_.-]+/g, ' ').replace(/\d+/g, '').trim();
    var words = raw.split(/\s+/).filter(Boolean);
    if (!words.length) return '';
    var titles = ['dr', 'mr', 'mrs', 'ms', 'prof', 'engr', 'barr', 'pastor', 'chief'];
    function cap(w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); }
    if (words.length >= 2 && titles.indexOf(words[0].toLowerCase()) !== -1) {
        return cap(words[0]) + ' ' + cap(words[1]);
    }
    return cap(words[0]);
}

function fonFindNaturalVoice(voices) {
    if (!voices || !voices.length) return null;

    function scoreVoice(v) {
        var name = (v.name || '').toLowerCase();
        var lang = (v.lang || '').toLowerCase();
        var score = 0;

        // Must be English
        if (lang.indexOf('en') !== 0) return -2000;

        // 1. Nigerian English neural/natural voice (+1500)
        if (lang === 'en-ng' || lang.indexOf('en-ng') === 0 || name.indexOf('nigeria') !== -1) {
            score += 1500;
        }

        // 2. Neural / Natural / Premium / Online indicators (+900 to +1000)
        if (name.indexOf('natural') !== -1) score += 1000;
        if (name.indexOf('neural') !== -1) score += 950;
        if (name.indexOf('online') !== -1) score += 700;
        if (name.indexOf('enhanced') !== -1) score += 600;
        if (name.indexOf('premium') !== -1) score += 600;

        // 3. Known high-fidelity human-sounding voices (+500)
        var topVoices = [
            'jenny', 'aria', 'sonia', 'ryan', 'guy', 'ezinne', 'abeo',
            'google uk english female', 'google us english', 'google uk english male',
            'samantha', 'serena', 'karen', 'daniel', 'olivia', 'ava', 'allison', 'victoria'
        ];
        for (var i = 0; i < topVoices.length; i++) {
            if (name.indexOf(topVoices[i]) !== -1) {
                score += 500;
                break;
            }
        }

        // 4. Windows SAPI fallback preference: Zira >> David
        if (name.indexOf('zira') !== -1) {
            score += 400;
        }

        // Female voices in standard TTS have significantly less mechanical distortion
        if (name.indexOf('female') !== -1) {
            score += 150;
        }

        // 5. Preferred English locales (British, Nigerian, US, Canadian, Australian)
        if (lang === 'en-gb') score += 120;
        if (lang === 'en-us') score += 100;
        if (lang === 'en-ca' || lang === 'en-au') score += 80;

        // 6. PENALTY: Severe penalty for legacy robotic / monotone SAPI5 voices
        if (name.indexOf('david') !== -1) score -= 800;
        if (name.indexOf('desktop') !== -1) score -= 150;
        if (name.indexOf('mark') !== -1) score -= 400;
        if (name.indexOf('hazel') !== -1) score -= 300;
        if (name.indexOf('george') !== -1) score -= 300;

        return score;
    }

    var bestVoice = voices[0];
    var bestScore = -99999;
    for (var i = 0; i < voices.length; i++) {
        var s = scoreVoice(voices[i]);
        if (s > bestScore) {
            bestScore = s;
            bestVoice = voices[i];
        }
    }
    return bestVoice;
}

$(function () {
    var is_day_enabled = getCookieValue('day_status');
    var myDate = new Date();
    var hrs = myDate.getHours();
    var greetingWord = "";
    var greet;
    var color;
    var quote;
    if (hrs < 12) {
        greetingWord = "<?php echo addslashes($wo['lang']['good_morning']); ?>";
        greet = greetingWord + ', <?php echo addslashes($wo['user']['name']); ?> <img src="<?php echo $wo['config']['theme_url'];?>/img/sunrise.png"/>';
        color = '#7FC583';
        quote = "<?php echo function_exists('Wo_RandomMorningGreeting') ? addslashes(Wo_RandomMorningGreeting()) : addslashes($wo['lang']['good_morning_quote']); ?>";
    } else if (hrs >= 12 && hrs <= 18) {
        greetingWord = "<?php echo addslashes($wo['lang']['good_afternoon']); ?>";
        greet = greetingWord + ', <?php echo addslashes($wo['user']['name']); ?> <img src="<?php echo $wo['config']['theme_url'];?>/img/sun.png"/>';
        color = '#ffc107';
        quote = "<?php echo function_exists('Wo_RandomAfternoonGreeting') ? addslashes(Wo_RandomAfternoonGreeting()) : addslashes($wo['lang']['good_afternoon_quote']); ?>";
    } else {
        greetingWord = "<?php echo addslashes($wo['lang']['good_evening']); ?>";
        greet = greetingWord + ', <?php echo addslashes($wo['user']['name']); ?> <img src="<?php echo $wo['config']['theme_url'];?>/img/sunset.png"/>';
        color = '#FF4F70';
        quote = "<?php echo function_exists('Wo_RandomEveningGreeting') ? addslashes(Wo_RandomEveningGreeting()) : addslashes($wo['lang']['good_evening_quote']); ?>";
    }
    if (!greetingWord) greetingWord = "Good day";

    window.fonSpeakGreeting = function() {
        if (!('speechSynthesis' in window)) return;
        
        // Toggle: if already speaking, cancel
        if (window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
            $('.fon-tts-speaker i').removeClass('text-success fon-pulse-speaking');
            return;
        }

        window.speechSynthesis.cancel();

        var memberName = fonExtractFriendlyName("<?php echo addslashes($wo['user']['name']); ?>", "<?php echo !empty($wo['user']['first_name']) ? addslashes($wo['user']['first_name']) : ''; ?>");
        
        var cleanQuote = stripHtml(quote || '');
        // Strip duplicate leading greeting from quote
        cleanQuote = cleanQuote.replace(/^(good\s+(morning|afternoon|evening|day)[!.,;:\s-]*)+/i, '').trim();
        // Strip emojis
        cleanQuote = cleanQuote.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, '').trim();

        // Conversational greeting: punctuation introduces natural breathing pause
        var speechText = (memberName ? (greetingWord + ", " + memberName + "! ") : (greetingWord + "! ")) + cleanQuote;

        var utterance = new SpeechSynthesisUtterance(speechText);
        var voices = window.speechSynthesis.getVoices();
        var naturalVoice = fonFindNaturalVoice(voices);
        if (naturalVoice) {
            utterance.voice = naturalVoice;
            utterance.lang = naturalVoice.lang || 'en-US';
        } else {
            utterance.lang = 'en-US';
        }

        // Natural prosody: 1.0 cadence and 1.04 warm pitch
        utterance.rate = 1.0;
        utterance.pitch = 1.04;
        utterance.volume = 1.0;

        var $speakerIcon = $('.fon-tts-speaker i');
        utterance.onstart = function() {
            $speakerIcon.addClass('text-success fon-pulse-speaking');
        };
        utterance.onend = function() {
            $speakerIcon.removeClass('text-success fon-pulse-speaking');
        };
        utterance.onerror = function() {
            $speakerIcon.removeClass('text-success fon-pulse-speaking');
        };

        window.speechSynthesis.speak(utterance);
    };

    if (is_day_enabled != 1) {
      setTimeout(function () {
        $('.greetalert').css('border-left', '2.5px solid ' + color );
        $('#daynightmsg').html('<div class="small-texts">' + greet + ' <button type="button" class="btn btn-default btn-xs fon-tts-speaker" onclick="fonSpeakGreeting();" title="Listen to greeting" style="border: none; background: transparent; color: inherit; font-size: 15px; margin-left: 8px; cursor: pointer; padding: 0 4px; vertical-align: middle;"><i class="fa fa-volume-up"></i></button></div><p>' + quote + '</p>');
        $('.greetalert').removeClass('hidden');

        if ('speechSynthesis' in window) {
            var voices = window.speechSynthesis.getVoices();
            if (voices && voices.length > 0) {
                fonSpeakGreeting();
            } else {
                window.speechSynthesis.onvoiceschanged = function() {
                    window.speechSynthesis.onvoiceschanged = null;
                    fonSpeakGreeting();
                };
                setTimeout(function() {
                    if (!window.speechSynthesis.speaking) {
                        fonSpeakGreeting();
                    }
                }, 400);
            }
        }
      }, 100);
    }
});
